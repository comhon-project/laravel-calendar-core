{
    "name": "comhon-project/laravel-calendar-core",
    "description": "a laravel calendar library that faciliate events scheduling (only backend part) ",
    "keywords": [
        "comhon-project",
        "laravel",
        "laravel-calendar-core"
    ],
    "homepage": "https://github.com/comhon-project/laravel-calendar-core",
    "license": "MIT",
    "authors": [
        {
            "name": "jean-philippe perrotton",
            "email": "jeanphilippe.perrotton@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "comhon-project/laravel-morphed-model-exporter": "^1.0.1",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0|^8.1",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Comhon\\Calendar\\": "src/",
            "Comhon\\Calendar\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\": "workbench/app/",
            "Database\\": "workbench/database/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-calendar-core --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Comhon\\Calendar\\CalendarServiceProvider"
            ],
            "aliases": {
                "Calendar": "Comhon\\Calendar\\Facades\\Calendar"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
